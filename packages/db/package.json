{
  "name": "@olivia/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "tsc -b",
    "check-types": "tsc -b",
