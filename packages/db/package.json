  },
  "dependencies": {
    "@olivia/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@olivia/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
