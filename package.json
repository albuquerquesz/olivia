{
  "name": "olivia",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "better-auth": "1.6.23"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint -F server -F @olivia/db -F @olivia/auth -F @olivia/env",
    "check-types": "turbo run check-types",
    "dev:server": "turbo run dev -F server",
    "dev:android": "turbo run dev -F android",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:push": "turbo run db:push -F @olivia/db",
    "db:studio": "turbo run db:studio -F @olivia/db",
    "db:generate": "turbo run db:generate -F @olivia/db",
    "db:migrate": "turbo run db:migrate -F @olivia/db"
  },
  "dependencies": {
    "@olivia/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@olivia/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
