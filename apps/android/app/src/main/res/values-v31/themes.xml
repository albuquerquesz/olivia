<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Olivia" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/olivia_background</item>
        <item name="android:statusBarColor">@color/olivia_background</item>
        <item name="android:navigationBarColor">@color/olivia_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/olivia_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/olivia_logo</item>
    </style>
</resources>
