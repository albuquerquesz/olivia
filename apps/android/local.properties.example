# Copie para local.properties e preencha. local.properties é ignorado pelo Git.

# Caminho do Android SDK.
# Windows: sdk.dir=C\:\\Users\\<voce>\\AppData\\Local\\Android\\Sdk
# macOS:   sdk.dir=/Users/<voce>/Library/Android/sdk
sdk.dir=

# Credenciais da integração registrada no Wearables Developer Center. Nunca versionar.
# Alternativas de CI: MWDAT_APPLICATION_ID e MWDAT_CLIENT_TOKEN.
# Em Developer Mode, mantenha ambas vazias: o build usa 0/0 explicitamente.
mwdat_application_id=
mwdat_client_token=

# Somente no flavor glassesDebug: ativa MockDeviceKit com a camera traseira do telefone.
# Nao use para demonstrar hardware real; deixe false/vazio para os oculos pareados.
mwdat_mock_device_kit=false
