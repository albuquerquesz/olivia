# Configuração do runner. Copiar os campos necessários para o .env na raiz.
# Offline não exige nenhum dos outros campos. Não preencher com credenciais no Git.
OLIVIA_TEST_MODE=offline
OLIVIA_AI_MODEL=gemini-3.5-flash-lite
OLIVIA_FIREBASE_PROJECT_ID=
OLIVIA_FIREBASE_CONFIG_PATH=
FIREBASE_APP_CHECK_DEBUG_TOKEN=
OLIVIA_LIVE_AI_MAX_REQUESTS=12
# Estimativa conservadora por chamada, definida pelo operador segundo preço/tokens.
# Multiplicada pelo limite de chamadas, deve caber no orçamento abaixo.
OLIVIA_LIVE_AI_ESTIMATED_COST_PER_REQUEST_USD=
OLIVIA_LIVE_AI_MAX_ESTIMATED_COST_USD=
# Fixture de áudio e modelo multilíngue whisper.cpp, ambos locais e somente leitura.
OLIVIA_WHISPER_MODEL_PATH=
OLIVIA_WHISPER_MODEL_SHA256=
OLIVIA_WHISPER_FIXTURE_PATH=
OLIVIA_WHISPER_FIXTURE_SHA256=
OLIVIA_WHISPER_EXPECTED_TEXT=
