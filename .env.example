NODE_ENV=development
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5436/olivia


PICOVOICE=
GITHUB_READ_PACKAGES=
# Local-only Firebase AI/App Check configuration for Android instrumentation tests. Never deploy it.
OLIVIA_LIVE_AI_ENABLED=false
OLIVIA_AI_MODEL=gemini-3.5-flash-lite
FIREBASE_APP_CHECK_DEBUG_TOKEN=
